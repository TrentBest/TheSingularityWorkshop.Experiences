{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrentBest/TheSingularityWorkshop.Experiences/blob/development/docs/contracts/experience-manifest.schema.json",
  "title": "Workshop Experience Manifest",
  "description": "Host-independent, versioned Experience identity, immutable artifact roots, and semantic requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experienceId",
    "experienceKey",
    "version",
    "title",
    "artifacts",
    "requirements"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "experienceId": { "type": "integer", "minimum": 1 },
    "experienceKey": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "version": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
    "title": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundleId", "version", "sha256"],
        "properties": {
          "bundleId": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
          "version": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityId", "contractVersions", "required", "rationale"],
        "properties": {
          "capabilityId": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u001F\\u007F]+$" },
          "contractVersions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimumInclusive", "maximumExclusive"],
            "properties": {
              "minimumInclusive": { "$ref": "#/$defs/contractVersion" },
              "maximumExclusive": {
                "oneOf": [
                  { "$ref": "#/$defs/contractVersion" },
                  { "type": "null" }
                ]
              }
            }
          },
          "required": { "type": "boolean" },
          "rationale": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "contractVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "patch"],
      "properties": {
        "major": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 },
        "patch": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
