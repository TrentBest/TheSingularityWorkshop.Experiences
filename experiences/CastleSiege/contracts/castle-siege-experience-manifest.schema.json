{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TrentBest/TheSingularityWorkshop.Experiences/blob/development/experiences/CastleSiege/contracts/castle-siege-experience-manifest.schema.json",
  "title": "Castle Siege Experience Manifest",
  "description": "Renderer-independent, versioned authored identity and capability declaration for Castle Siege.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experienceId",
    "experienceKey",
    "version",
    "title",
    "artifacts",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "experienceId": {
      "const": 3301
    },
    "experienceKey": {
      "const": "castle-siege"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "version",
          "sha256"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityId",
          "level",
          "rationale"
        ],
        "properties": {
          "capabilityId": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "Required",
              "Preferred",
              "Optional",
              "Delegable",
              "FrameCritical"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
