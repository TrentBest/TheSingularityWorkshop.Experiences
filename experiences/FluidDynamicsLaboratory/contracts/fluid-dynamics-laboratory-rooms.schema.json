{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesingularityworkshop.com/schemas/fluid-dynamics-laboratory-rooms.schema.json",
  "title": "Fluid Dynamics Laboratory Room Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "experienceKey", "status", "rooms"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "experienceKey": { "const": "fluid-dynamics-laboratory" },
    "status": { "enum": ["preforge", "design-preview", "interactive-authoring", "simulation-preview", "validated-showcase"] },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roomKey", "sequence", "title", "purpose", "visitorAction", "authoritativeState", "evidenceRule", "maturity", "requiredCapabilities", "nextRooms"],
        "properties": {
          "roomKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "sequence": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "visitorAction": { "type": "string", "minLength": 1 },
          "authoritativeState": { "type": "string", "minLength": 1 },
          "evidenceRule": { "type": "string", "minLength": 1 },
          "maturity": { "enum": ["concept", "authored-preview", "calculated", "simulated", "validated"] },
          "requiredCapabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "nextRooms": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "uniqueItems": true }
        }
      }
    }
  }
}