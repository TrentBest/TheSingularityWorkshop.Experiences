  "cleanup": {
    "itemIdentity": "stable-experience-authored-id",
    "itemType": "story-grounded-litter",
    "artworkPlacement": "separate-normalized-artwork-relative-hit-region",
    "states": [
      "available",
      "approaching",
      "picked-up",
      "carrying",
      "depositing",
      "deposited"
    ],
    "transitions": [
      {
        "from": "available",
        "action": "reader-selects-litter",
        "to": "approaching"
      },
      {
        "from": "approaching",
        "action": "pickup-animation-completes",
        "to": "carrying"
      },
      {
        "from": "carrying",
        "action": "reader-selects-receptacle",
        "to": "depositing"
      },
      {
        "from": "depositing",
        "action": "deposit-animation-completes",
        "to": "deposited",
        "counterEffect": "increment-exactly-once"
      }
    ],
    "interruption": {
      "beforePickupCompletes": "return-item-to-available",
      "whileCarrying": "preserve-held-item-and-resume-carrying",
      "beforeDepositCompletes": "preserve-held-item-and-resume-carrying",
      "afterDepositCompletes": "remain-deposited"
    },
    "counter": {
      "owner": "lenny-experience-state",
      "source": "unique-deposited-item-ids",
      "exposeTo": "extra-pages",
      "persistAt": "experience-runtime-boundary"
    }
  },
  "accessibility": {
    "inputModes": [
