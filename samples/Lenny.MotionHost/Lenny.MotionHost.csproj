<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WorkshopPhysicsRoot Condition="'$(WorkshopPhysicsRoot)' == ''">$(MSBuildThisFileDirectory)../../../TheSingularityWorkshop.Physics</WorkshopPhysicsRoot>
    <WorkshopPhysicsMicroBundlesProject>$(WorkshopPhysicsRoot)/TheSingularityWorkshop.Physics.MicroBundles.csproj</WorkshopPhysicsMicroBundlesProject>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(WorkshopPhysicsMicroBundlesProject)')">
    <ProjectReference Include="$(WorkshopPhysicsMicroBundlesProject)" />
  </ItemGroup>
  <Target Name="RequirePhysicsMicroBundleSource" BeforeTargets="ResolveReferences"
          Condition="!Exists('$(WorkshopPhysicsMicroBundlesProject)')">
    <Error Text="Lenny's Physics host sample requires TheSingularityWorkshop.Physics checked out at '$(WorkshopPhysicsRoot)'. Set WorkshopPhysicsRoot to that checkout." />
  </Target>
</Project>