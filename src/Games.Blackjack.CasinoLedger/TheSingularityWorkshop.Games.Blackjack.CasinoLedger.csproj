<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>TheSingularityWorkshop.Games.Blackjack.CasinoLedger</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>The Singularity Workshop</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>Explicit adapter for settling simulation-only Blackjack wagers through CasinoLedger.</Description>
    <PackageTags>singularity;workshop;blackjack;casino;ledger;simulation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.Experiences</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Games.Blackjack/TheSingularityWorkshop.Games.Blackjack.csproj" />
    <ProjectReference Include="../Games.CasinoLedger/TheSingularityWorkshop.Games.CasinoLedger.csproj" />
  </ItemGroup>
</Project>