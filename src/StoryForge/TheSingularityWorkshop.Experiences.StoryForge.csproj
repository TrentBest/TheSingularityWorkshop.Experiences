<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>TheSingularityWorkshop.Experiences.StoryForge</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>The Singularity Workshop</Authors>
    <Company>The Singularity Workshop</Company>
    <Description>Renderer-independent story data, temporal coverage, and immutable edition foundations for the Story Forge Experience.</Description>
    <PackageTags>singularity;workshop;experience;story;timeline;worldbuilding;microbundle</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/TrentBest/TheSingularityWorkshop.Experiences</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>